---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import BackToTop from "@components/control/BackToTop.astro";
import SideBar from "@components/widget/SideBar.astro";
import ArticleNavigation from "@components/widget/ArticleNavigation.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
const isArticlePage = setOGTypeArticle === true || Astro.url.pathname.startsWith("/posts/");
const hasArticleNavigation = isArticlePage && siteConfig.toc.enable && headings.length > 0;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-4 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class=`absolute z-10 w-full transition duration-700 overflow-hidden` style=`top: -${BANNER_HEIGHT_EXTEND}vh`>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style=`top: ${mainPanelTop}`>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div id="main-panel-shell" class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full grid grid-cols-1 grid-rows-[auto_auto_auto] lg:grid-rows-[auto]
            lg:grid-cols-[17.5rem_minmax(0,1fr)] mx-auto gap-4 px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            {hasArticleNavigation
                ? <ArticleNavigation title={title} headings={headings} />
                : <SideBar class="mb-4 row-start-2 col-span-1 lg:mb-0 lg:row-start-1 lg:col-start-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>
            }

            <main id="swup-container" class:list={[
                "transition-swup-fade col-span-1 min-w-0 lg:row-start-1 lg:col-start-2 overflow-hidden",
                hasArticleNavigation ? "row-start-2" : "row-start-1",
            ]}>
                <div id="content-wrapper" class="onload-animation min-w-0">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <aside id="right-panel-wrapper" class="hidden min-w-0 lg:row-start-1 lg:col-start-3">
                <div class="sticky top-[5.5rem]">
                    <slot name="right-panel"></slot>
                </div>
            </aside>

            <div class="footer col-span-1 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

</Layout>


<style is:global>
/*
 * 首頁響應式版心：
 * - 1024–1535px：左側欄 + 文章雙欄，維持舒適閱讀寬度。
 * - >=1536px：右側工具欄正式成為第三欄，三欄由同一個 grid 約束，不再靠 absolute 掛在版心外。
 * 這樣瀏覽器縮放、不同桌機寬度與視窗縮放時，都不會把右欄推出 viewport。
 */
@media (min-width: 1024px) {
    body.is-home #top-row,
    body.is-home #main-panel-shell {
        max-width: 73.5rem;
    }

    body.is-home #navbar > .card-base {
        max-width: none;
        width: 100%;
    }

    body.is-home #main-grid {
        width: 100%;
        max-width: none;
        grid-template-columns: clamp(13.5rem, 18vw, 15.25rem) minmax(0, 1fr);
        gap: 1rem;
    }

    body.is-home #sidebar {
        max-width: 15.25rem !important;
        min-width: 0;
    }

    body.is-home #sidebar .card-base,
    body.is-home #sidebar .tlink {
        box-shadow: none;
        border-color: color-mix(in oklab, currentColor 11%, transparent);
    }

    body.is-home #sidebar .tlink {
        padding: 11px 12px;
    }

    body.is-home #swup-container {
        min-width: 0;
        overflow: visible;
    }
}

@media (min-width: 1536px) {
    body.is-home #top-row,
    body.is-home #main-panel-shell {
        max-width: 87.5rem;
    }

    body.is-home #main-grid {
        grid-template-columns: 15.25rem minmax(0, 1fr) 13.25rem;
    }

    body.is-home #right-panel-wrapper {
        display: block;
        width: 13.25rem;
        min-width: 0;
    }

    body.is-home #right-panel-wrapper .card-base,
    body.is-home #right-panel-wrapper .tlink {
        box-shadow: none;
        border-color: color-mix(in oklab, currentColor 10%, transparent);
    }
}
</style>