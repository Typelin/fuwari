---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { SCHEDULE, TIME_SLOTS, WEEKDAYS } from "../config/schedule";

const title = "課表";

const courseColors: Record<string, string> = {
	"導師時間": "oklch(0.70 0.12 250)",
	"電路板佈線實務": "oklch(0.70 0.16 145)",
	"人工智慧實務": "oklch(0.70 0.16 280)",
	"工程倫理與社會": "oklch(0.70 0.14 50)",
	"動態網頁設計": "oklch(0.70 0.16 200)",
	"機率與統計": "oklch(0.70 0.14 330)",
	"智慧健康產品設計": "oklch(0.70 0.16 170)",
	"日本流行產業(B)": "oklch(0.70 0.14 25)",
};

function getCourseColor(name: string): string {
	return courseColors[name] || "oklch(0.70 0.12 var(--hue))";
}

// Pre-compute lunch break position (after slot index 3, which is period 4)
const LUNCH_AFTER_SLOT = 3;
---

<MainGridLayout title={title}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative z-10">
        <div class="card-base z-10 px-4 sm:px-9 py-6 relative w-full">

            <div class="flex items-center gap-3 mb-6">
                <Icon name="material-symbols:calendar-month" class="text-3xl text-[var(--primary)]" />
                <h1 class="text-2xl font-bold dark:text-white/90 text-black/80">我的課表</h1>
            </div>

            <!-- Current class status -->
            <div id="schedule-status" class="mb-4 p-4 rounded-xl border border-[var(--primary)]/20 bg-[var(--primary)]/5">
                <div id="status-current" class="font-bold text-lg mb-1 dark:text-white/90 text-black/80">✅ 課程狀態載入中</div>
                <div id="status-next" class="text-sm dark:text-white/60 text-black/50"></div>
            </div>

            <!-- VIEW TOGGLE -->
            <div class="flex items-center gap-2 mb-4">
                <button id="btn-view-today" class="px-4 py-1.5 rounded-lg text-sm font-bold bg-[var(--primary)] text-white transition" onclick="switchView('today')">今日</button>
                <button id="btn-view-all" class="px-4 py-1.5 rounded-lg text-sm font-bold bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/60 hover:bg-black/10 dark:hover:bg-white/10 transition" onclick="switchView('all')">全部</button>
            </div>

            <!-- Schedule table -->
            <div class="overflow-x-auto -mx-4 sm:mx-0 rounded-lg">
                <table class="schedule-table w-full border-collapse text-sm min-w-[700px]">
                    <thead>
                        <tr>
                            <th class="schedule-th sticky-col">時間</th>
                            {WEEKDAYS.slice(0, 5).map((day, i) => (
                                <th class="schedule-th" data-day={i}>{day}</th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {TIME_SLOTS.map((slot, si) => {
                            const isAfterLunch = si === LUNCH_AFTER_SLOT + 1;
                            return (
                                <>
                                    {/* Lunch break row */}
                                    {isAfterLunch && (
                                        <tr class="lunch-row">
                                            <td colspan={6} class="lunch-cell">
                                                <div class="flex items-center justify-center gap-2">
                                                    <Icon name="material-symbols:restaurant" class="text-base" />
                                                    <span>午休 12:00 ~ 12:50</span>
                                                </div>
                                            </td>
                                        </tr>
                                    )}
                                    <tr>
                                        <td class="schedule-time sticky-col">
                                            <div class="font-bold">{slot.period}</div>
                                            <div class="text-xs opacity-60">{slot.startTime}~{slot.endTime}</div>
                                        </td>
                                        {WEEKDAYS.slice(0, 5).map((_, di) => {
                                            const entry = SCHEDULE[di]?.[si];
                                            if (!entry) {
                                                return <td class="schedule-cell schedule-empty" data-day={di}>—</td>;
                                            }
                                            const prevEntry = si > 0 ? SCHEDULE[di]?.[si - 1] : null;
                                            if (prevEntry && prevEntry.name === entry.name && prevEntry.location === entry.location) {
                                                return null;
                                            }
                                            let span = 1;
                                            for (let k = si + 1; k < TIME_SLOTS.length; k++) {
                                                const next = SCHEDULE[di]?.[k];
                                                if (next && next.name === entry.name && next.location === entry.location) {
                                                    span++;
                                                } else break;
                                            }
                                            const color = getCourseColor(entry.name);
                                            return (
                                                <td class="schedule-cell schedule-course" rowspan={span} data-day={di}
                                                    style={`--course-color: ${color}; border-left: 3px solid ${color};`}>
                                                    <div class="font-bold text-sm leading-tight dark:text-white/90 text-black/80">{entry.name}</div>
                                                    <div class="text-xs mt-1 flex items-center gap-1 dark:text-white/50 text-black/50">
                                                        <Icon name="material-symbols:location-on-outline" class="text-xs" />
                                                        {entry.location}
                                                    </div>
                                                </td>
                                            );
                                        })}
                                    </tr>
                                </>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
    .schedule-table {
        border-spacing: 0;
    }
    .schedule-th {
        padding: 0.75rem 0.5rem;
        text-align: center;
        font-weight: 700;
        font-size: 0.875rem;
        background: oklch(0.40 0.10 var(--hue));
        color: white;
    }
    .schedule-th:first-child {
        border-radius: 0.5rem 0 0 0;
    }
    .schedule-th:last-child {
        border-radius: 0 0.5rem 0 0;
    }
    .schedule-time {
        padding: 0.5rem;
        text-align: center;
        font-size: 0.75rem;
        background: oklch(0.25 0.02 var(--hue)); /* 實心深色底，防止滾動重疊 */
        border-bottom: 1px solid oklch(0.5 0 0 / 0.1);
        border-right: 1px solid oklch(0.5 0 0 / 0.1);
        white-space: nowrap;
        color: oklch(0.85 0 0);
    }
    :global(.light) .schedule-time {
        background: oklch(0.95 0.02 var(--hue)); /* 實心亮色底 */
        color: oklch(0.3 0 0);
    }
    .schedule-cell {
        padding: 0.5rem;
        border-bottom: 1px solid oklch(0.5 0 0 / 0.1);
        vertical-align: middle;
        text-align: center;
    }
    .schedule-empty {
        opacity: 0.2;
    }
    .schedule-course {
        background: oklch(from var(--course-color) l c h / 0.12);
        text-align: left;
        transition: background 0.2s ease;
    }
    .schedule-course:hover {
        background: oklch(from var(--course-color) l c h / 0.25);
    }
    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 2;
        /* 手機版滾動時的右側邊界陰影感 */
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
    }
    .schedule-th.sticky-col {
        z-index: 3; /* 表頭的時間欄必須在最上層 */
    }
    .lunch-cell {
        padding: 0.5rem;
        text-align: center;
        font-size: 0.8rem;
        font-weight: 600;
        background: oklch(0.50 0.10 80 / 0.15);
        color: oklch(0.75 0.12 80);
        border-bottom: 1px solid oklch(0.5 0 0 / 0.1);
        letter-spacing: 0.05em;
    }
    :global(.light) .lunch-cell {
        background: oklch(0.90 0.08 80);
        color: oklch(0.45 0.10 80);
    }

    :global(.schedule-today) {
        background: oklch(0.5 0.1 var(--hue) / 0.12) !important;
    }

    /* 視角切換: 全域隱藏非今日欄位 */
    :global(.view-today) [data-day] {
        display: none !important;
    }
    :global(.view-today) [data-day].is-today {
        display: table-cell !important;
    }
</style>

<script is:inline define:vars={{ scheduleData: JSON.stringify(SCHEDULE), timeSlotsData: JSON.stringify(TIME_SLOTS) }}>
(function() {
    var SCHEDULE = JSON.parse(scheduleData);
    var TIME_SLOTS = JSON.parse(timeSlotsData);

    function updateScheduleStatus() {
        var now = new Date();
        var parts = now.toLocaleString("en-US", { timeZone: "Asia/Taipei" }).split(/[\/, :]+/);
        var utc8 = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Taipei" }));
        var rawDay = utc8.getDay();
        var dayIndex = rawDay === 0 ? 6 : rawDay - 1;
        var currentMinutes = utc8.getHours() * 60 + utc8.getMinutes();

        // If today is weekend, fallback "Today" view to Monday (dayIndex 0)
        var viewDayIndex = dayIndex >= 5 ? 0 : dayIndex;

        var statusCurrent = document.getElementById("status-current");
        var statusNext = document.getElementById("status-next");
        if (!statusCurrent || !statusNext) return;

        // Highlight and mark today column
        document.querySelectorAll("[data-day]").forEach(function(el) {
            var d = parseInt(el.getAttribute("data-day") || "-1");
            if (d === viewDayIndex) {
                el.classList.add("is-today");
                if (el.tagName === 'TH') el.style.background = "oklch(0.5 0.12 var(--hue))";
            }
        });

        var todaySchedule = SCHEDULE[viewDayIndex] || [];

        function toMin(t) {
            var p = t.split(":");
            return parseInt(p[0]) * 60 + parseInt(p[1]);
        }

        // Find current class
        var currentClass = null;
        var currentEnd = 0;
        for (var i = 0; i < TIME_SLOTS.length; i++) {
            var start = toMin(TIME_SLOTS[i].startTime);
            var end = toMin(TIME_SLOTS[i].endTime);
            if (currentMinutes >= start && currentMinutes < end && todaySchedule[i]) {
                currentClass = todaySchedule[i];
                currentEnd = end;
                for (var j = i + 1; j < TIME_SLOTS.length; j++) {
                    var nx = todaySchedule[j];
                    if (nx && nx.name === currentClass.name) {
                        currentEnd = toMin(TIME_SLOTS[j].endTime);
                    } else break;
                }
                break;
            }
        }

        var lunchStart = 720; // 12:00
        var lunchEnd = 770;   // 12:50
        var isLunch = currentMinutes >= lunchStart && currentMinutes < lunchEnd;

        // Find next class
        var nextClass = null;
        var nextStart = 0;
        for (var i = 0; i < TIME_SLOTS.length; i++) {
            var s = toMin(TIME_SLOTS[i].startTime);
            if (s > currentMinutes && todaySchedule[i]) {
                nextClass = todaySchedule[i];
                nextStart = s;
                break;
            }
        }

        function fmt(mins) {
            if (mins <= 0) return "即將開始";
            var h = Math.floor(mins / 60);
            var m = mins % 60;
            return h > 0 ? h + " 小時 " + m + " 分鐘" : m + " 分鐘";
        }

        if (currentClass) {
            var rem = currentEnd - currentMinutes;
            statusCurrent.innerHTML = '📚 當前：<span style="color:var(--primary);font-weight:700">' + currentClass.name + '</span>（' + currentClass.location + '）— 還有 ' + fmt(rem) + ' 下課';
        } else if (isLunch) {
            statusCurrent.innerHTML = '🍱 午休中 — 還有 ' + fmt(lunchEnd - currentMinutes);
        } else if (dayIndex >= 5) {
            statusCurrent.textContent = '🎉 週末愉快！今天沒有課程。';
        } else if (!todaySchedule.some(function(x){return !!x;})) {
            statusCurrent.textContent = '🎉 今天沒有課程！';
        } else if (nextClass) {
            statusCurrent.textContent = '⏸️ 目前沒有課程';
        } else {
            statusCurrent.textContent = '✅ 今日課程已結束！';
        }

        if (nextClass) {
            var rem2 = nextStart - currentMinutes;
            statusNext.innerHTML = '⏭️ 下一節：<span style="font-weight:600">' + nextClass.name + '</span>（' + nextClass.location + '）— ' + fmt(rem2) + '後';
        } else if (currentClass) {
            statusNext.textContent = '這是今天的最後一堂課了！';
        } else {
            statusNext.textContent = '';
        }
    }

    window.switchView = function(mode) {
        var table = document.querySelector('.schedule-table');
        var btnToday = document.getElementById('btn-view-today');
        var btnAll = document.getElementById('btn-view-all');
        var lunchCell = document.querySelector('.lunch-cell');
        if (!table) return;

        var aCls = "px-4 py-1.5 rounded-lg text-sm font-bold bg-[var(--primary)] text-white transition";
        var iCls = "px-4 py-1.5 rounded-lg text-sm font-bold bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/60 hover:bg-black/10 dark:hover:bg-white/10 transition";

        if (mode === 'today') {
            table.classList.add('view-today');
            table.style.minWidth = '100%';
            if (btnToday) btnToday.className = aCls;
            if (btnAll) btnAll.className = iCls;
            if (lunchCell) lunchCell.setAttribute('colspan', '2');
        } else {
            table.classList.remove('view-today');
            table.style.minWidth = '700px';
            if (btnToday) btnToday.className = iCls;
            if (btnAll) btnAll.className = aCls;
            if (lunchCell) lunchCell.setAttribute('colspan', '6');
        }
    };

    // Run immediately
    function init() {
        updateScheduleStatus();
        if (window.innerWidth < 768) {
            window.switchView('today');
        } else {
            window.switchView('all');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    setInterval(updateScheduleStatus, 30000);
})();
</script>
