---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import Profile from "./Profile.astro";
import ScheduleCard from "./ScheduleCard.astro";
import Categories from "./Categories.astro";
import Tags from "./Tags.astro";
import "../../styles/tlink.css";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>

    <!-- Tikana 的小店（推廣） -->
    <a href="https://pay.ldxp.cn/shop/T2MMIX28" target="_blank" rel="noopener noreferrer sponsored"
       aria-label="前往 Tikana 的小店"
       class="tlink block mb-4 onload-animation" style="--a1: #f59e0b; --a2: #ec4899; animation-delay: 75ms">
        <div class="tlink__icon">
            <Icon name="material-symbols:shopping-cart-rounded" class="text-xl" />
        </div>
        <div class="min-w-0">
            <div class="tlink__title dark:text-neutral-50 text-neutral-800">
                <span class="truncate">Tikana 的小店</span>
                <span class="px-2 py-0.5 text-xs font-bold rounded-md bg-amber-500 text-white leading-none shadow-sm">推廣</span>
            </div>
            <div class="tlink__desc text-neutral-500 dark:text-neutral-400">GPT Plus · Gemini Pro · Grok · 反重力成品號</div>
        </div>
        <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-xl text-neutral-500 dark:text-neutral-300" />
    </a>

    <!-- 個人作品集入口卡片 -->
    <a href="https://dev.typelin.me/" target="_blank" rel="noopener noreferrer"
       aria-label="前往關於我的網頁"
       class="tlink block mb-4 onload-animation" style="--a1: #7b68ee; --a2: #ff0080; animation-delay: 100ms">
        <div class="tlink__icon">
            <Icon name="material-symbols:account-circle" class="text-xl" />
        </div>
        <div class="min-w-0">
            <div class="tlink__title dark:text-neutral-50 text-neutral-800"><span class="truncate">關於我的網頁</span></div>
            <div class="tlink__desc text-neutral-500 dark:text-neutral-400">個人介紹、專案作品與技術能力</div>
        </div>
        <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-xl text-neutral-500 dark:text-neutral-300" />
    </a>

    <!-- Typelin 遊戲站 -->
    <a href="https://game.typelin.me/" target="_blank" rel="noopener noreferrer"
       aria-label="前往 Typelin 遊戲站"
       class="tlink block mb-4 onload-animation" style="--a1: #22c55e; --a2: #6366f1; animation-delay: 125ms">
        <div class="tlink__icon">
            <Icon name="material-symbols:stadia-controller" class="text-xl" />
        </div>
        <div class="min-w-0">
            <div class="tlink__title dark:text-neutral-50 text-neutral-800"><span class="truncate">Typelin 遊戲站</span></div>
            <div class="tlink__desc text-neutral-500 dark:text-neutral-400">原創網頁遊戲與互動作品</div>
        </div>
        <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-xl text-neutral-500 dark:text-neutral-300" />
    </a>

    <!-- TYPELIN 實測展廳 -->
    <a href="https://arena.typelin.me/" target="_blank" rel="noopener noreferrer"
       aria-label="前往 TYPELIN 實測展廳"
       class="tlink block mb-4 onload-animation" style="--a1: #16150f; --a2: #c8402a; animation-delay: 140ms; flex-direction: column; align-items: stretch">
        <div class="flex items-center gap-3">
            <div class="tlink__icon">
                <Icon name="material-symbols:trophy" class="text-xl" />
            </div>
            <div class="min-w-0 flex-1">
                <div class="tlink__title dark:text-neutral-50 text-neutral-800">
                    <span class="truncate">TYPELIN 實測展廳</span>
                    <span class="px-2 py-0.5 text-xs font-bold rounded-md text-white leading-none shadow-sm" style="background: #c8402a">PK</span>
                </div>
                <div class="tlink__desc text-neutral-500 dark:text-neutral-400">同題 PK · 首批分數已公布</div>
            </div>
            <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-xl text-neutral-500 dark:text-neutral-300" />
        </div>
        <div class="trank">
            <div class="trank__row"><span class="text-neutral-500 dark:text-neutral-400">01 · OPUS 4.6</span><b style="color: #c8402a">88</b></div>
            <div class="trank__row"><span class="text-neutral-500 dark:text-neutral-400">02 · QWEN 3.8</span><b class="dark:text-neutral-100 text-neutral-800">81</b></div>
            <div class="trank__row"><span class="text-neutral-500 dark:text-neutral-400">03 · SPARK 1.3</span><b class="dark:text-neutral-100 text-neutral-800">75</b></div>
        </div>
    </a>

    <!-- 課程即時狀態卡片 -->
    <ScheduleCard />

    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tags class="onload-animation" style="animation-delay: 200ms"></Tags>
    </div>
</div>

