---
/**
 * 手機專用快捷橫滑列（lg 以下顯示）
 * 桌機側欄的四張連結卡太沉底，手機頂部直接給一條橫滑捷徑。
 */
import { Icon } from "astro-icon/components";
import "../../styles/tlink.css";

const LINKS = [
  { href: "https://arena.typelin.me/", icon: "material-symbols:trophy", a1: "#16150f", a2: "#c8402a", title: "實測展廳", sub: "Opus 88" },
  { href: "https://game.typelin.me/", icon: "material-symbols:stadia-controller", a1: "#22c55e", a2: "#6366f1", title: "遊戲站", sub: "開玩" },
  { href: "https://dev.typelin.me/", icon: "material-symbols:account-circle", a1: "#7b68ee", a2: "#ff0080", title: "關於我", sub: "作品集" },
  { href: "https://pay.ldxp.cn/shop/T2MMIX28", icon: "material-symbols:shopping-cart-rounded", a1: "#f59e0b", a2: "#ec4899", title: "小店", sub: "推廣" },
];
---
<div class="lg:hidden -mx-1 px-1 mb-4 onload-animation" aria-label="站外快捷連結">
    <div class="tchips">
        {LINKS.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer"
               class="tchip" style={`--a1: ${l.a1}; --a2: ${l.a2}`}>
                <span class="tchip__icon"><Icon name={l.icon} class="text-lg" /></span>
                <span class="tchip__text">
                    <b>{l.title}</b>
                    <i>{l.sub}</i>
                </span>
            </a>
        ))}
    </div>
</div>

<style>
    .tchips {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 2px 2px 8px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }
    .tchips::-webkit-scrollbar { display: none; }
    .tchip {
        flex: none;
        scroll-snap-align: start;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 14px 9px 9px;
        border-radius: 999px;
        background: var(--card-bg);
        border: 1px solid rgba(130, 130, 130, 0.25);
        text-decoration: none;
    }
    .tchip:active { transform: scale(0.96); }
    .tchip__icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--a1), var(--a2));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex: none;
    }
    .tchip__text { display: flex; flex-direction: column; line-height: 1.3; }
    .tchip__text b { font-size: 13.5px; font-weight: 800; }
    .tchip__text i { font-style: normal; font-size: 11px; opacity: 0.6; font-family: ui-monospace, monospace; }
</style>
