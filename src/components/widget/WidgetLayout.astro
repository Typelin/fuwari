---
import { Icon } from "astro-icon/components";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, isCollapsed, style } = Astro.props;
const className = Astro.props.class;
---
<div data-id={id} class={"card-base " + className} style={style}>
    <details class="group transition duration-300" open={!isCollapsed}>
        <summary class="flex justify-between items-center font-bold text-lg text-neutral-900 dark:text-neutral-100 px-8 py-4 cursor-pointer select-none
            hover:bg-[var(--card-bg-hover)] transition-colors rounded-t-2xl relative
            before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:left-4 before:top-[1.35rem]">
            {name}
            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-3xl transition-transform duration-300 group-open:rotate-180 text-neutral-400 group-hover:text-[var(--primary)]"></Icon>
        </summary>
        <div id={id} class="px-4 pb-4 animate-fade-in-down">
            <slot></slot>
        </div>
    </details>
</div>

<style>
    details > summary {
        list-style: none;
    }
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>
