---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";
import TOC from "./TOC.astro";

interface Props {
    title?: string;
    headings?: MarkdownHeading[];
}

const { title = "文章", headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
    minDepth = Math.min(minDepth, heading.depth);
}

const visibleHeadings = headings.filter((heading) => heading.depth < minDepth + 3);
const topLevelCount = headings.filter((heading) => heading.depth === minDepth).length;

const cleanHeading = (text: string) => text.endsWith("#") ? text.slice(0, -1) : text;
---

<!-- 手機 / 平板：維持文章寬度，提供可展開的精簡目錄。 -->
<details class="article-mobile-nav card-base row-start-1 col-span-1 lg:hidden overflow-hidden onload-animation">
    <summary class="list-none cursor-pointer px-4 py-3.5 flex items-center gap-3 select-none">
        <span class="w-9 h-9 rounded-xl bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center shrink-0">
            <Icon name="material-symbols:format-list-bulleted-rounded" class="text-xl" />
        </span>
        <span class="min-w-0 flex-1">
            <span class="block text-[0.68rem] tracking-[0.14em] font-bold text-[var(--primary)]">ARTICLE NAV</span>
            <span class="block font-bold text-sm text-90 truncate">文章導覽</span>
        </span>
        <span class="text-xs text-50 whitespace-nowrap">{topLevelCount || visibleHeadings.length} 節</span>
        <Icon name="material-symbols:expand-more-rounded" class="article-mobile-nav__chevron text-xl text-50 transition-transform" />
    </summary>
    <nav class="border-t border-black/5 dark:border-white/10 p-2 max-h-[45vh] overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="文章導覽">
        {visibleHeadings.map((heading) => (
            <a href={`#${heading.slug}`} class:list={[
                "flex items-start gap-2 rounded-lg px-3 py-2 text-sm leading-snug transition hover:bg-[var(--toc-btn-hover)] hover:text-[var(--primary)]",
                heading.depth === minDepth ? "font-bold text-90" : "text-75",
                heading.depth === minDepth + 1 ? "ml-3" : "",
                heading.depth >= minDepth + 2 ? "ml-6 text-50" : "",
            ]}>
                <span class="mt-[0.45rem] w-1.5 h-1.5 rounded-full bg-[var(--primary)] opacity-70 shrink-0"></span>
                <span>{cleanHeading(heading.text)}</span>
            </a>
        ))}
    </nav>
</details>

<!-- 桌機：首頁的個人側欄在文章頁原位切換成文章導覽。 -->
<aside id="article-navigation" class="hidden lg:block lg:row-start-1 lg:col-start-1 min-w-0 w-full onload-animation">
    <div class="article-navigation__rail sticky top-[5.5rem] flex min-h-0 flex-col gap-3 overflow-hidden">
        <div class="card-base shrink-0 border border-black/5 dark:border-white/10 p-3.5">
            <a href={url('/')} class="group inline-flex items-center gap-1.5 text-xs font-bold text-50 hover:text-[var(--primary)] transition mb-3">
                <Icon name="material-symbols:arrow-back-rounded" class="text-base transition-transform group-hover:-translate-x-0.5" />
                返回文章列表
            </a>
            <div class="text-[0.66rem] tracking-[0.16em] font-black text-[var(--primary)] mb-1.5">ARTICLE NAV</div>
            <div class="font-bold text-[0.98rem] leading-snug text-90 line-clamp-3" title={title}>{title}</div>
            <div class="flex items-center gap-2 mt-3 pt-3 border-t border-black/5 dark:border-white/10 text-xs text-50">
                <Icon name="material-symbols:format-list-bulleted-rounded" class="text-base text-[var(--primary)]" />
                <span>{topLevelCount || visibleHeadings.length} 個主要段落</span>
            </div>
        </div>

        <div class="article-navigation__toc-shell relative min-h-0 flex-1 overflow-hidden">
            <div class="article-navigation__scroll-hint pointer-events-none absolute right-3 top-2 z-20 rounded-full px-2 py-1 text-[10px] font-bold tracking-wide text-50">
                SCROLL
            </div>
            <div id="toc" class="h-full w-full min-w-0">
                <TOC headings={headings} class="h-full max-h-none" />
            </div>
            <div class="article-navigation__fade pointer-events-none absolute inset-x-0 bottom-0 z-10 h-8"></div>
        </div>
    </div>
</aside>

<style>
    .article-navigation__rail {
        max-height: calc(100vh - 6.5rem);
    }

    .article-navigation__toc-shell {
        flex: none;
        height: clamp(14rem, calc(100vh - 17.5rem), 38rem);
    }

    .article-navigation__scroll-hint {
        background: color-mix(in oklab, var(--float-panel-bg-opaque) 88%, transparent);
        backdrop-filter: blur(8px);
        opacity: 0;
        transition: opacity .2s ease;
    }

    .article-navigation__fade {
        background: linear-gradient(to bottom, transparent, var(--float-panel-bg-opaque));
        opacity: 0;
        transition: opacity .2s ease;
    }

    .article-navigation__toc-shell.is-scrollable:not(.is-scrolled) .article-navigation__scroll-hint {
        opacity: .82;
    }

    .article-navigation__toc-shell.is-scrollable:not(.is-at-bottom) .article-navigation__fade {
        opacity: .9;
    }

    .article-mobile-nav[open] .article-mobile-nav__chevron {
        transform: rotate(180deg);
    }

    .article-mobile-nav summary::-webkit-details-marker {
        display: none;
    }
</style>

<script>
let scrollObserver: ResizeObserver | undefined;

function setupArticleNavigationScroll() {
    const shell = document.querySelector<HTMLElement>('.article-navigation__toc-shell');
    const toc = document.querySelector<HTMLElement>('#article-navigation #toc-inner-wrapper');
    if (!shell || !toc) return;

    const update = () => {
        const scrollable = toc.scrollHeight > toc.clientHeight + 2;
        const atBottom = toc.scrollTop + toc.clientHeight >= toc.scrollHeight - 3;
        shell.classList.toggle('is-scrollable', scrollable);
        shell.classList.toggle('is-scrolled', toc.scrollTop > 10);
        shell.classList.toggle('is-at-bottom', !scrollable || atBottom);
    };

    toc.addEventListener('scroll', update, { passive: true });
    scrollObserver?.disconnect();
    scrollObserver = new ResizeObserver(update);
    scrollObserver.observe(toc);
    update();
}

setupArticleNavigationScroll();

// swup 的 DOM 事件名是 swup:<hook>，所以是 swup:visit:end，
// 不是舊版的 swup:contentReplaced（那個永遠不會觸發）。
if (window.swup?.hooks) {
    window.swup.hooks.on('visit:end', setupArticleNavigationScroll);
} else {
    document.addEventListener('swup:enable', () => {
        window.swup.hooks.on('visit:end', setupArticleNavigationScroll);
    });
}
</script>

<style is:global>
    #article-navigation .article-toc-scroll {
        height: 100%;
        max-height: none;
        padding-top: 2.4rem;
        padding-bottom: 2rem;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in oklab, var(--primary) 55%, transparent) color-mix(in oklab, currentColor 8%, transparent);
        overscroll-behavior: contain;
        scroll-behavior: smooth;
    }

    #article-navigation .article-toc-scroll::-webkit-scrollbar {
        width: 7px;
    }

    #article-navigation .article-toc-scroll::-webkit-scrollbar-track {
        background: color-mix(in oklab, currentColor 7%, transparent);
        border-radius: 999px;
    }

    #article-navigation .article-toc-scroll::-webkit-scrollbar-thumb {
        background: color-mix(in oklab, var(--primary) 58%, transparent);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;
    }

    #article-navigation .article-toc-scroll::-webkit-scrollbar-thumb:hover {
        background: color-mix(in oklab, var(--primary) 78%, transparent);
        background-clip: padding-box;
    }

    @media (max-height: 700px) {
        #article-navigation .article-toc-scroll {
            padding-top: 2rem;
        }

        #article-navigation .article-navigation__rail > .card-base {
            padding-top: .7rem;
            padding-bottom: .7rem;
        }
    }
</style>
