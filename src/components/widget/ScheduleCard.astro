---
/**
 * Sidebar schedule mini-card
 * Shows current/next class info with a link to the full schedule page
 */
import { Icon } from "astro-icon/components";
import { SCHEDULE, TIME_SLOTS } from "../../config/schedule";
---

<a href="/schedule/" class="block mb-4 onload-animation schedule-mini-card-link" style="animation-delay: 120ms">
    <div class="card-base p-3 border border-black/10 dark:border-white/10 schedule-mini-card">
        <div class="flex items-center gap-2 mb-2">
            <Icon name="material-symbols:calendar-month" class="text-lg text-[var(--primary)]" />
            <span class="font-bold text-sm dark:text-neutral-50 text-neutral-800 transition">課程狀態</span>
            <Icon name="material-symbols:arrow-outward" class="text-xs ml-auto opacity-40" />
        </div>
        <div id="sidebar-schedule-current" class="text-xs leading-relaxed dark:text-neutral-300 text-neutral-600 truncate">
            ✅ 載入中
        </div>
        <div id="sidebar-schedule-next" class="text-xs leading-relaxed dark:text-neutral-400 text-neutral-500 truncate mt-0.5">
        </div>
    </div>
</a>

<style>
    .schedule-mini-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }
    .schedule-mini-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px oklch(0.5 0.1 var(--hue) / 0.15);
    }
    .schedule-mini-card-link {
        text-decoration: none;
    }
</style>

<script is:inline define:vars={{ sidebarScheduleData: JSON.stringify(SCHEDULE), sidebarTimeSlotsData: JSON.stringify(TIME_SLOTS) }}>
(function() {
    var SCHEDULE = JSON.parse(sidebarScheduleData);
    var TIME_SLOTS = JSON.parse(sidebarTimeSlotsData);

    function updateSidebarSchedule() {
        var now = new Date();
        var utc8 = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Taipei" }));
        var rawDay = utc8.getDay();
        var dayIndex = rawDay === 0 ? 6 : rawDay - 1;
        var currentMinutes = utc8.getHours() * 60 + utc8.getMinutes();

        var elCurrent = document.getElementById("sidebar-schedule-current");
        var elNext = document.getElementById("sidebar-schedule-next");
        if (!elCurrent || !elNext) return;

        var todaySchedule = SCHEDULE[dayIndex] || [];

        function toMin(t) {
            var p = t.split(":");
            return parseInt(p[0]) * 60 + parseInt(p[1]);
        }

        function fmtRemain(mins) {
            if (mins <= 0) return "即將";
            var h = Math.floor(mins / 60);
            var m = mins % 60;
            return h > 0 ? h + "h" + m + "m" : m + "m";
        }

        var currentClass = null;
        var currentEnd = 0;
        for (var i = 0; i < TIME_SLOTS.length; i++) {
            var s = toMin(TIME_SLOTS[i].startTime);
            var e = toMin(TIME_SLOTS[i].endTime);
            if (currentMinutes >= s && currentMinutes < e && todaySchedule[i]) {
                currentClass = todaySchedule[i];
                currentEnd = e;
                for (var j = i + 1; j < TIME_SLOTS.length; j++) {
                    var nx = todaySchedule[j];
                    if (nx && nx.name === currentClass.name) {
                        currentEnd = toMin(TIME_SLOTS[j].endTime);
                    } else break;
                }
                break;
            }
        }

        var isLunch = currentMinutes >= 720 && currentMinutes < 770;

        var nextClass = null;
        var nextStart = 0;
        for (var i = 0; i < TIME_SLOTS.length; i++) {
            var s2 = toMin(TIME_SLOTS[i].startTime);
            if (s2 > currentMinutes && todaySchedule[i]) {
                nextClass = todaySchedule[i];
                nextStart = s2;
                break;
            }
        }

        if (currentClass) {
            var rem = currentEnd - currentMinutes;
            elCurrent.innerHTML = '📚 <b>' + currentClass.name + '</b> · ' + currentClass.location + ' · 剩 ' + fmtRemain(rem);
        } else if (isLunch) {
            elCurrent.innerHTML = '🍱 午休中 · 剩 ' + fmtRemain(770 - currentMinutes);
        } else if (dayIndex >= 5 || !todaySchedule.some(function(x){return !!x;})) {
            elCurrent.textContent = '🎉 今天沒有課程';
        } else if (nextClass) {
            elCurrent.textContent = '⏸️ 目前沒有課程';
        } else {
            elCurrent.textContent = '✅ 今日課程已結束';
        }

        if (nextClass) {
            var rem2 = nextStart - currentMinutes;
            elNext.innerHTML = '⏭️ ' + nextClass.name + ' · ' + nextClass.location + ' · ' + fmtRemain(rem2) + '後';
        } else {
            elNext.textContent = '';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateSidebarSchedule);
    } else {
        updateSidebarSchedule();
    }
    setInterval(updateSidebarSchedule, 30000);
})();
</script>
