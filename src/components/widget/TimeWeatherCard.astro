---
/**
 * Time & Weather Card (Desktop Right Panel)
 * - Live UTC+8 clock
 * - IP-based geolocation weather (fallback: Tainan)
 * - Uses wttr.in API (no API key required)
 */
import { Icon } from "astro-icon/components";
---

<div class="card-base p-[1.05rem] right-panel-card">
    <!-- Time Section -->
    <div class="flex items-center gap-2 mb-3">
        <Icon name="material-symbols:schedule" class="text-lg text-[var(--primary)]" />
        <span class="font-bold text-[0.92rem] dark:text-neutral-50 text-neutral-800">時間與天氣</span>
    </div>

    <div id="rp-clock" class="text-center mb-4 mt-2">
        <div id="rp-time" class="text-[1.85rem] font-extrabold tracking-[0.08em] dark:text-white/95 text-black/90 font-mono">
            --:--:--
        </div>
        <div id="rp-date" class="text-[0.84rem] mt-1 sm:mt-2 font-medium dark:text-white/70 text-black/60">
            載入中...
        </div>
    </div>

    <div class="h-px bg-black/5 dark:bg-white/10 my-3"></div>

    <!-- Weather Section -->
    <div id="rp-weather">
        <div id="rp-weather-location" class="text-[0.84rem] leading-5 font-medium dark:text-white/70 text-black/60 mb-3">
            📍 定位中...
        </div>
        <div class="flex items-center gap-3 mb-2">
            <div class="relative w-12 h-12 flex items-center justify-center rounded-lg overflow-hidden bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">
                <div id="rp-weather-fx" class="absolute inset-0 pointer-events-none"></div>
                <div id="rp-weather-icon" class="text-3xl leading-none relative z-10 drop-shadow-md">⏳</div>
            </div>
            <div id="rp-weather-temp" class="text-[1.65rem] font-bold dark:text-white/95 text-black/90">
                --°C
            </div>
        </div>
        <div id="rp-weather-desc" class="text-[0.84rem] leading-5 font-medium dark:text-white/70 text-black/60 mb-3">
            --
        </div>
        <div class="flex items-center gap-4 text-[0.82rem] font-medium dark:text-white/60 text-black/50">
            <span id="rp-weather-rain" class="flex items-center gap-1"><Icon name="material-symbols:water-drop-outline" class="text-lg"/> --%</span>
            <span id="rp-weather-humidity" class="flex items-center gap-1"><Icon name="material-symbols:humidity-percentage" class="text-lg"/> --%</span>
        </div>
    </div>
</div>

<style>
    .right-panel-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .right-panel-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px oklch(0.5 0.1 var(--hue) / 0.12);
    }
    #rp-time {
        text-shadow: 0 0 20px oklch(0.6 0.15 var(--hue) / 0.3);
    }
    
    /* --- Pixel Art Weather FX --- */
    /* Sun */
    :global(.weather-fx-sun) {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 150%; height: 150%;
        background: radial-gradient(circle, rgba(255,180,0,0.4) 0%, rgba(255,180,0,0) 60%);
        animation: pixelSunPulse 1.5s steps(3, end) infinite;
    }
    @keyframes pixelSunPulse {
        0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.8; }
        50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.5; }
        100% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.8; }
    }
    
    /* Cloud (Dark Grey) */
    :global(.weather-fx-cloud) {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent, rgba(50,50,50,0.25));
        animation: pixelCloudMove 3s steps(4, end) infinite alternate;
    }
    :global(.dark) :global(.weather-fx-cloud) {
        background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.5));
    }
    @keyframes pixelCloudMove {
        0% { transform: translateX(-2px); }
        100% { transform: translateX(2px); }
    }
    
    /* Rain (Diagonal falling) */
    :global(.weather-fx-rain) {
        position: absolute;
        inset: -20px;
        overflow: hidden;
    }
    :global(.weather-fx-drop) {
        position: absolute;
        width: 2px;
        height: 6px;
        background: #60a5fa;
        transform: rotate(20deg);
        box-shadow: 2px 2px 0 rgba(255,255,255,0.2);
    }
    :global(.weather-fx-drop:nth-child(1)) { top: -10px; left: 30%; animation: pixelRain 0.6s steps(6, end) infinite; }
    :global(.weather-fx-drop:nth-child(2)) { top: -10px; left: 60%; animation: pixelRain 0.7s steps(6, end) infinite 0.2s; }
    :global(.weather-fx-drop:nth-child(3)) { top: -10px; left: 80%; animation: pixelRain 0.5s steps(6, end) infinite 0.4s; }
    
    @keyframes pixelRain {
        0% { transform: translate(0, 0) rotate(20deg); opacity: 1; }
        100% { transform: translate(-6px, 30px) rotate(20deg); opacity: 0; }
    }
    
    /* Moon */
    :global(.weather-fx-moon) {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 2rem; height: 2rem;
        background: radial-gradient(circle, rgba(150,200,255,0.2) 0%, transparent 60%);
        animation: pixelMoonPulse 2s steps(2, end) infinite alternate;
    }
    @keyframes pixelMoonPulse {
        0% { transform: translate(-50%, -50%) scale(0.9); }
        100% { transform: translate(-50%, -50%) scale(1.1); }
    }
</style>

<script is:inline>
(function() {
    // 定位失敗時的後備座標（台南）
    var FALLBACK_LOCATION = { lat: 22.9909, lon: 120.2128, label: 'Tainan, Taiwan' };

    // --- Clock ---
    function updateClock() {
        var now = new Date();
        var utc8 = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Taipei" }));
        var h = String(utc8.getHours()).padStart(2, '0');
        var m = String(utc8.getMinutes()).padStart(2, '0');
        var s = String(utc8.getSeconds()).padStart(2, '0');

        var timeEl = document.getElementById('rp-time');
        var dateEl = document.getElementById('rp-date');
        if (timeEl) timeEl.textContent = h + ':' + m + ':' + s;

        if (dateEl) {
            var weekdays = ['日', '一', '二', '三', '四', '五', '六'];
            var y = utc8.getFullYear();
            var mo = String(utc8.getMonth() + 1).padStart(2, '0');
            var d = String(utc8.getDate()).padStart(2, '0');
            dateEl.textContent = y + '/' + mo + '/' + d + ' 週' + weekdays[utc8.getDay()];
        }
    }

    function normalizeLocationLabel(label) {
        var parts = String(label || '').split(',').map(function(p) { return p.trim(); }).filter(Boolean);
        if (parts.length >= 2 && parts[0].toLowerCase() === parts[1].toLowerCase()) return parts[0];
        return parts.join(', ');
    }

    // --- 天氣判定 ---
    // 只看結構化欄位，不看文字描述。
    // 這是從 wttr.in 換過來的教訓：它的文字在雲量 80% 上下就吐
    // "Patchy rain nearby"，但同一份資料的降水量是 0.0mm —— 文字會說下雨，
    // 實際上一滴都沒有。所以這裡以 precipitation 為準：沒有降水量就不講雨，
    // 改依雲量描述天空。這樣「說下雨」與「實際下雨」才不會脫鉤。
    var CONDITIONS = {
        thunder:          { label: '雷雨',     icon: '⛈️',  fx: 'rain' },
        'heavy-rain':     { label: '大雨',     icon: '🌧️', fx: 'rain' },
        rain:             { label: '有雨',     icon: '🌧️', fx: 'rain' },
        drizzle:          { label: '小雨',     icon: '🌦️', fx: 'rain' },
        snow:             { label: '降雪',     icon: '🌨️', fx: 'cloud' },
        overcast:         { label: '陰天',     icon: '☁️',  fx: 'cloud' },
        cloudy:           { label: '多雲',     icon: '☁️',  fx: 'cloud' },
        'partly-cloudy':  { label: '局部多雲', icon: '⛅',  fx: '' },
        clear:            { label: '晴朗',     icon: '☀️',  fx: 'sun' },
        'clear-night':    { label: '晴朗',     icon: '🌙',  fx: 'moon' },
        fog:              { label: '有霧',     icon: '🌫️', fx: 'cloud' }
    };

    var FX = {
        rain: '<div class="weather-fx-rain"><div class="weather-fx-drop"></div><div class="weather-fx-drop"></div><div class="weather-fx-drop"></div></div>',
        cloud: '<div class="weather-fx-cloud"></div>',
        sun: '<div class="weather-fx-sun"></div>',
        moon: '<div class="weather-fx-moon"></div>',
        '': ''
    };

    // WMO weather code：45/48 霧、51-57 毛毛雨、61-67 雨、71-77 雪、
    // 80-82 陣雨、85-86 陣雪、95-99 雷雨。
    // 但代碼本身也可能過度樂觀，所以有無降水一律以 precipitation 為準。
    function resolveCondition(current) {
        var code = Number(current.weather_code);
        var precip = Number(current.precipitation);
        var cloud = Number(current.cloud_cover);
        var isDay = Number(current.is_day) === 1;

        if (code === 45 || code === 48) return 'fog';

        if (!isNaN(precip) && precip > 0) {
            if (code >= 95) return 'thunder';
            if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
            if (precip < 0.5) return 'drizzle';
            if (precip < 2.5) return 'rain';
            return 'heavy-rain';
        }

        if (!isNaN(cloud)) {
            if (cloud >= 85) return 'overcast';
            if (cloud >= 60) return 'cloudy';
            if (cloud >= 25) return 'partly-cloudy';
            return isDay ? 'clear' : 'clear-night';
        }

        return null;
    }

    // 降雨機率。Open-Meteo 的 hourly.time 是「被定位城市的當地時間」，
    // 而 current.time 也已經是同一時區，所以用字串前 13 碼（到小時）比對就好，
    // 完全不需要做時區換算 —— 也就不會有「拿瀏覽器時區去比當地時段」的錯。
    function pickRainChance(hourly, currentTime) {
        if (!hourly || !hourly.time || !hourly.time.length) return null;
        var key = String(currentTime || '').slice(0, 13);
        for (var i = 0; i < hourly.time.length; i++) {
            if (String(hourly.time[i]).slice(0, 13) === key) {
                var p = hourly.precipitation_probability && hourly.precipitation_probability[i];
                return (p === null || p === undefined) ? null : p;
            }
        }
        return null;
    }

    function weatherUrl(loc) {
        return 'https://api.open-meteo.com/v1/forecast'
            + '?latitude=' + loc.lat + '&longitude=' + loc.lon
            + '&current=temperature_2m,relative_humidity_2m,precipitation,weather_code,cloud_cover,is_day'
            + '&hourly=precipitation_probability'
            + '&forecast_days=1'
            + '&timezone=auto';
    }

    var RAIN_ICON = '<svg class="w-4 h-4 mr-1 inline-block" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C12 2 5 10.08 5 14.5C5 18.09 7.91 21 11.5 21C15.09 21 18 18.09 18 14.5C18 10.08 12 2 12 2Z"/></svg>';
    var HUMIDITY_ICON = '<svg class="w-4 h-4 mr-1 inline-block" viewBox="0 0 24 24"><path fill="currentColor" d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,10V16H13V10H11Z"/></svg>';

    function paint(view) {
        var iconEl = document.getElementById('rp-weather-icon');
        var fxEl = document.getElementById('rp-weather-fx');
        var locEl = document.getElementById('rp-weather-location');
        var tempEl = document.getElementById('rp-weather-temp');
        var descEl = document.getElementById('rp-weather-desc');
        var rainEl = document.getElementById('rp-weather-rain');
        var humEl = document.getElementById('rp-weather-humidity');

        if (iconEl) iconEl.textContent = view.icon;
        if (fxEl) fxEl.innerHTML = view.fx || '';
        if (locEl) locEl.textContent = '📍 ' + normalizeLocationLabel(view.location);
        if (tempEl) tempEl.innerHTML = view.temp + '<span class="text-xl ml-1">°C</span>';
        if (descEl) descEl.textContent = view.label;
        if (rainEl) rainEl.innerHTML = RAIN_ICON + (view.rain === null ? '--' : view.rain) + '%';
        if (humEl) humEl.innerHTML = HUMIDITY_ICON + view.humidity + '%';
    }

    var WEATHER_TTL = 30 * 60 * 1000;
    var GEO_TTL = 7 * 24 * 60 * 60 * 1000;
    var CACHE_VERSION = 2;

    function renderFromCache() {
        try {
            var cache = JSON.parse(localStorage.getItem('rp-weather-cache') || '{}');
            // 舊版是 wttr.in 的資料形狀，欄位對不上，直接忽略重抓
            if (cache.v !== CACHE_VERSION || !cache.ts) return false;
            if (Date.now() - cache.ts >= WEATHER_TTL) return false;
            paint(cache);
            return true;
        } catch (e) {
            return false;
        }
    }

    // 定位結果快取 7 天。ipapi.co 免費額度是每 IP 每天 1000 次，原本每次載入
    // 都打一次，重整幾次就會被限流，然後全站訪客都被迫看到後備的台南。
    function resolveLocation(done) {
        try {
            var geo = JSON.parse(localStorage.getItem('rp-geo-cache') || '{}');
            if (geo.ts && Date.now() - geo.ts < GEO_TTL && geo.lat && geo.lon) {
                done(geo);
                return;
            }
        } catch (e) {}

        fetch('https://ipapi.co/json/')
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (!res || res.error || !res.latitude || !res.longitude) throw new Error('geo unavailable');
                var loc = {
                    ts: Date.now(),
                    lat: res.latitude,
                    lon: res.longitude,
                    label: (res.city || res.region || 'Tainan') + ', ' + (res.country_name || 'Taiwan')
                };
                try { localStorage.setItem('rp-geo-cache', JSON.stringify(loc)); } catch (e) {}
                done(loc);
            })
            .catch(function() { done(FALLBACK_LOCATION); });
    }

    function fetchWeather(loc) {
        fetch(weatherUrl(loc))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var current = data && data.current;
                if (!current) return;

                var condition = resolveCondition(current);
                var meta = CONDITIONS[condition];
                // 認不出來就退回後備座標再試一次，避免整張卡空白
                if (!meta) {
                    if (loc !== FALLBACK_LOCATION) fetchWeather(FALLBACK_LOCATION);
                    return;
                }

                var view = {
                    v: CACHE_VERSION,
                    ts: Date.now(),
                    location: loc.label,
                    temp: Math.round(Number(current.temperature_2m)),
                    humidity: Math.round(Number(current.relative_humidity_2m)),
                    rain: pickRainChance(data.hourly, current.time),
                    label: meta.label,
                    icon: meta.icon,
                    fx: FX[meta.fx] || ''
                };

                paint(view);
                try { localStorage.setItem('rp-weather-cache', JSON.stringify(view)); } catch (e) {}
            })
            .catch(function() {
                if (loc !== FALLBACK_LOCATION) fetchWeather(FALLBACK_LOCATION);
            });
    }

    function loadWeather() {
        if (renderFromCache()) return;
        resolveLocation(fetchWeather);
    }

    // Init
    updateClock();
    setInterval(updateClock, 1000);
    loadWeather();
    // Refresh weather every 30 min
    setInterval(loadWeather, 30 * 60 * 1000);
})();
</script>
