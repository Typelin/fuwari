---
/**
 * Right Panel Container
 * Desktop only (2xl breakpoint) - positioned to the right of main content
 * Contains: TimeWeatherCard + CalendarCard + Standalone Promo Card
 */
import TimeWeatherCard from "./TimeWeatherCard.astro";
import CalendarCard from "./CalendarCard.astro";
import { Icon } from "astro-icon/components";
import "../../styles/tlink.css";
---

<div class="flex flex-col gap-4 w-[14rem]">
    <TimeWeatherCard />
    <CalendarCard />

    <!-- 實測展廳迷你卡 -->
    <a href="https://arena.typelin.me/" target="_blank" rel="noopener noreferrer"
       aria-label="前往 TYPELIN 實測展廳"
       class="tlink tlink--sm mb-4" style="--a1: #16150f; --a2: #c8402a">
        <div class="tlink__icon">
            <Icon name="material-symbols:trophy" class="text-base" />
        </div>
        <div class="min-w-0 flex-1">
            <div class="tlink__title dark:text-neutral-50 text-neutral-800">
                <span class="truncate">實測展廳</span>
                <span class="px-1.5 py-0.5 text-[0.65rem] font-bold rounded text-white leading-none" style="background: #c8402a">PK</span>
            </div>
            <div class="tlink__desc text-neutral-500 dark:text-neutral-400">Opus 88 · Qwen 81 · Spark 75</div>
        </div>
        <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-base text-neutral-500 dark:text-neutral-300" />
    </a>

    <!-- 行事曆下方獨立推廣卡片 -->
    <a href="https://pay.ldxp.cn/shop/T2MMIX28" target="_blank" rel="noopener noreferrer sponsored"
       aria-label="前往 Tikana 的小店"
       class="tlink tlink--sm" style="--a1: #f59e0b; --a2: #ec4899">
        <div class="tlink__icon">
            <Icon name="material-symbols:shopping-cart-rounded" class="text-base" />
        </div>
        <div class="min-w-0 flex-1">
            <div class="tlink__title dark:text-neutral-50 text-neutral-800">
                <span class="truncate">Tikana 的小店</span>
                <span class="px-1.5 py-0.5 text-[0.65rem] font-bold rounded bg-amber-500 text-white leading-none">推廣</span>
            </div>
            <div class="tlink__desc text-neutral-500 dark:text-neutral-400">成品號 · 教學售後群</div>
        </div>
        <Icon name="material-symbols:arrow-outward" class="tlink__arrow text-base text-neutral-500 dark:text-neutral-300" />
    </a>
</div>

