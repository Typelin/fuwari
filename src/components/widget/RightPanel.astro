---
/**
 * Right Panel Container
 * Desktop only (2xl breakpoint) - positioned to the right of main content
 * Contains: TimeWeatherCard + CalendarCard + Standalone Promo Card
 */
import TimeWeatherCard from "./TimeWeatherCard.astro";
import CalendarCard from "./CalendarCard.astro";
import { Icon } from "astro-icon/components";
---

<div class="flex flex-col gap-4 w-[14rem]">
    <TimeWeatherCard />
    <CalendarCard />
    
    <!-- 行事曆下方獨立推廣卡片 -->
    <a href="https://pay.ldxp.cn/shop/T2MMIX28" target="_blank" rel="noopener noreferrer sponsored"
       aria-label="前往 GPT/Gemini 卡網"
       class="card-base card-hover p-4 rounded-xl block text-decoration-none group transition relative overflow-hidden border border-amber-500/25 hover:border-amber-500/50">
        <div class="flex items-center gap-2 mb-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-amber-500 to-pink-500 flex items-center justify-center text-white shrink-0 shadow-xs">
                <Icon name="material-symbols:shopping-cart-rounded" class="text-base" />
            </div>
            <div class="font-bold text-sm dark:text-neutral-50 flex items-center gap-1.5">
                <span>GPT / Gemini 卡網</span>
                <span class="px-1.5 py-0.5 text-[0.65rem] font-bold rounded bg-amber-500 text-white leading-none shadow-xs">推廣</span>
            </div>
        </div>
        <p class="text-xs text-75 leading-relaxed mb-2.5">
            GPT Plus 帳號 · Gemini 成品號 · 24H 自動發卡
        </p>
        <div class="flex items-center justify-between text-xs font-bold text-amber-600 dark:text-amber-400 group-hover:translate-x-0.5 transition">
            <span>前往選購</span>
            <Icon name="material-symbols:arrow-outward" class="text-sm" />
        </div>
    </a>
</div>

